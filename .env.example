# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: register slash commands instantly in one server while developing
SYKE_DEV_GUILD_ID=

# Optional AI. With no key, SYKE writes summaries with its built-in offline roaster.
# SYKE_AI_PROVIDER can be: auto | openai | anthropic | none
SYKE_AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# User IDs (comma-separated) allowed to run admin commands in every server
SYKE_OWNER_IDS=1342786189576634398

# Tuning
SYKE_DB_PATH=syke.db
SYKE_SCAN_LIMIT=3000          # messages read per tracked channel
SYKE_MIN_MESSAGES=15          # messages needed before someone can be judged
SYKE_CACHE_MINUTES=15         # how long a channel scan is reused
SYKE_DEFAULT_TIMEZONE=UTC     # admins can override per server
SYKE_DEFAULT_PREFIX=!            # admins can change it per server with !prefix

# ── Owner web dashboard (optional) ──────────────────────────────────────────
# A private website to view every server SYKE is in, their channels and chats,
# and to act as the bot. Login is Discord OAuth, locked to SYKE_OWNER_IDS.
# Leave SYKE_WEB blank to keep it off. It turns on only when the three
# DISCORD_CLIENT_* / SYKE_WEB_SECRET values are all set.
SYKE_WEB=                       # 1 to enable
DISCORD_CLIENT_ID=              # Application ID (Developer Portal → General Information)
DISCORD_CLIENT_SECRET=          # OAuth2 → Client Secret
SYKE_WEB_SECRET=                # a long random string you make up (signs login cookies)
SYKE_WEB_BASE_URL=              # the public URL, e.g. https://syke-production.up.railway.app
# PORT is set by Railway automatically; locally it defaults to 8080.
