# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: register slash commands instantly in one server while developing
SYKE_DEV_GUILD_ID=

# Optional AI. With no key, SYKE writes summaries with its built-in offline roaster.
# SYKE_AI_PROVIDER can be: auto | openai | anthropic | none
SYKE_AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Tuning
SYKE_DB_PATH=syke.db
SYKE_SCAN_LIMIT=3000          # messages read per tracked channel
SYKE_MIN_MESSAGES=15          # messages needed before someone can be judged
SYKE_CACHE_MINUTES=15         # how long a channel scan is reused
SYKE_DEFAULT_TIMEZONE=UTC     # admins can override per server
SYKE_DEFAULT_PREFIX=!            # admins can change it per server with !prefix
